# Copy to .env for local runs, or set these as Railway service variables.

# Railway sets this automatically when you attach a Postgres service and
# reference it — see README-RAILWAY-MIGRATION.md for exact steps (including
# how to share one Postgres service across several apps instead of paying
# for a dedicated one per app).
DATABASE_URL=postgresql://user:password@host:5432/railway

# Optional — only needed when DATABASE_URL points at a database name that
# doesn't exist yet on a Postgres service you're SHARING with other apps.
# Point it at any database that already exists on that same server (the
# Postgres template's own default database works):
# DATABASE_ADMIN_URL=${{Postgres.DATABASE_URL}}

# A long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional: used to build the password-reset link that gets logged server
# side (see README — no email provider is wired up yet). Defaults to
# whatever host the request came in on if unset.
# APP_URL=https://stlouisbank.online

# Optional: set to "false" to disable running schema.sql automatically on
# boot (safe to leave on — every statement is idempotent).
AUTO_MIGRATE=true

# Optional: Railway sets PORT automatically, you don't need to set it.
# PORT=8080

# ── Email (OTP + password-reset notifications) ───────────────────────────
# Set these to actually SEND email. Until they're set, emails are logged to
# the server console instead (every flow stays testable). Works with any
# SMTP provider: Gmail, your cPanel/domain mailbox, SendGrid, Mailgun,
# Postmark, Resend, Amazon SES, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                     # 465 = SSL, 587 = STARTTLS
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=your-smtp-password-or-app-password
# MAIL_FROM=St Louis Shore Bank <no-reply@yourdomain.com>
MAIL_BRAND=St Louis Shore Bank
SUPPORT_EMAIL=support@stlouisshorebank.com
# SUPPORT_PHONE=+1 453 598 4512
